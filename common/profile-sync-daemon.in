#!/bin/bash

#
# Profile-sync-daemon by graysky <graysky AT archlinux DOT us>
# Inspired by some code originally written by Colin Verot
#

# shellcheck disable=1090,2154

# needed for debian >=8.x
PATH=$PATH:/sbin

if [[ -n "$LAUNCHED_BY_SYSTEMD" ]] ; then
# This script was invoked by systemd
# Thx to notes-jj: https://serverfault.com/questions/926349/systemd-tell-if-script-was-run-by-systemd-or-by-user
# No 'echo' ANSI escape codes
  BLD=''
  RED=''
  GRN=''
  BLU=''
  NRM=''
else
  BLD="\e[01m"
  RED="\e[01;31m"
  GRN="\e[01;32m"
  BLU="\e[01;34m"
  NRM="\e[00m"
fi
VERS="@VERSION@"

# msg goes to stdout; warn, error and die go to stderr, and die exits 1
msg() { echo -e "${BLD}$*${NRM}"; }
warn() { echo -e " ${RED}Warning:${NRM}${BLD} $*${NRM}" >&2; }
error() { echo -e " ${RED}Error:${NRM}${BLD} $*${NRM}" >&2; }
die() { error "$@"; exit 1; }

user=$(id -un)
HOME="$(getent passwd "$user" | cut -d: -f6)"
TMPDIR="${TMPDIR:-/tmp}"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
PSDCONFDIR="$XDG_CONFIG_HOME/psd"
PSDCONF="$PSDCONFDIR/psd.conf"
SHAREDIR="@SHAREDIR@"

if [[ ! -d "$SHAREDIR" ]]; then
  die "Missing ${BLU}$SHAREDIR${NRM}${BLD} - reinstall the package to use profile-sync-daemon."
fi

if [[ ! -d "$SHAREDIR/browsers" ]]; then
  die "Missing ${BLU}$SHAREDIR/browsers${NRM}${BLD} - reinstall the package to use profile-sync-daemon."
fi

if [[ $EUID -eq 0 ]]; then
  die "Do not call ${BLU}$0${NRM}${BLD} as root."
fi

# Create an XDG_RUNTIME_DIR if not given one (i.e. running without DE)
# See https://specifications.freedesktop.org/basedir-spec/basedir-spec-latest.html
if [[ -z "$XDG_RUNTIME_DIR" ]]; then
  XDG_RUNTIME_DIR="${TMPDIR}/runtime-${user}"
  echo -e " ${RED}WARNING:${NRM}${BLD} XDG_RUNTIME_DIR not set, defaulting to '${XDG_RUNTIME_DIR}'.${NRM}"
  if [[ ! -d "$XDG_RUNTIME_DIR" ]] && ! mkdir "$XDG_RUNTIME_DIR"; then
    die "Unable to create runtime directory '${XDG_RUNTIME_DIR}'."
  fi
  if ! chown "${user}" "${XDG_RUNTIME_DIR}"; then
    die "Unable to make user '${user}' owner of runtime directory '${XDG_RUNTIME_DIR}'."
  fi
  if ! chmod 0700 "${XDG_RUNTIME_DIR}"; then
    die "Unable to make runtime directory '${XDG_RUNTIME_DIR}' only accessible to user '$user'."
  fi
elif [[ ! -d "$XDG_RUNTIME_DIR" ]]; then
  die "Cannot find XDG_RUNTIME_DIR which should be set by systemd."
fi

VOLATILE="$XDG_RUNTIME_DIR/psd"
PID_FILE="$XDG_RUNTIME_DIR/psd.pid"

# runs that change state are serialized on this lock (see take_lock); every
# background child is started with the fd closed so the lock dies with us
exec {lockfd}>>"$XDG_RUNTIME_DIR/psd.lock" ||
  die "Unable to open $XDG_RUNTIME_DIR/psd.lock"

# Setup check for config file
if [[ -f "$PSDCONF" ]]; then
  if [[ ! -f "$PID_FILE" ]]; then
    # do nothing if psd is currently running, otherwise
    # make sure only comments and variables/arrays are defined to prevent
    # problems like issue #166
    if grep -Eqv '^$|^#|^[^ ]*=[^;]*' "$PSDCONF"; then
      # something that isn't a blank line, comment, or variable present
      # so exit
      echo -e " ${RED}ERROR:${NRM}${BLD} Syntax error(s) detected in ${BLU}$PSDCONF${NRM}${BLD} - edit and try again.${NRM}"
      echo -e "${NRM}${BLD}Line number: offending comment${NRM}"
      grep -Evn '^$|^#|^[^ ]*=[^;]*' "$PSDCONF"
      exit 1
    fi
  fi
  . "$PSDCONF"
elif [[ -d "$HOME/.psd" ]]; then
  # first check to see if a legacy ~/.psd is present and then move it to the
  # new location
  mkdir -p "$PSDCONFDIR"
  rsync -aX "$HOME/.psd/" "$PSDCONFDIR/"
  rm -rf "$HOME/.psd"
  echo " The use of $HOME/.psd is deprecated. Existing config has been moved to $PSDCONFDIR"
  # source it again retaining any user options
  [[ -f "$PSDCONF" ]] && . "$PSDCONF"
else
  mkdir -p "$PSDCONFDIR"
  if [[ -f "$SHAREDIR/psd.conf" ]]; then
    cp "$SHAREDIR/psd.conf" "$PSDCONFDIR"
    echo -e " First time running psd so please edit ${BLU}$PSDCONF${NRM}${BLD} to your liking and run again.${NRM}"
    exit 0
  fi
fi

# if psd is active, source the snapshot of psd.conf preferentially
# version 6.03 renames this file so if older version is running then
# rotate the old name to the new one

[[ -f "$PSDCONFDIR/.$user@$(uname -n).pid.conf" ]] &&
  mv "$PSDCONFDIR/.$user@$(uname -n).pid.conf" "$PSDCONFDIR/.psd.conf"

if [[ -f "$PID_FILE" ]]; then
  if [[ -f "$PSDCONFDIR/.psd.conf" ]]; then
    PSDCONF="$PSDCONFDIR/.psd.conf"
    unset USE_SUSPSYNC BROWSERS USE_BACKUPS BACKUP_LIMIT
    . "$PSDCONF"
    # defining VOLATILE in the config is deprecated since v6.16
    VOLATILE="$XDG_RUNTIME_DIR/psd"
  fi
fi

# define default number of crash-recovery snapshots to save if the user did not
# and check that it is an integer if user did define it
if [[ -z "$BACKUP_LIMIT" ]]; then
  BACKUP_LIMIT=5
else
  if [[ "$BACKUP_LIMIT" =~ ^[0-9]+$ ]]; then
    # correctly setup
    true
  else
    die "Bad value for BACKUP_LIMIT detected!"
  fi
fi

# scope to sync defined in BROWSERS array or from list of supported browsers
if [[ -z "$BROWSERS" ]]; then
  mapfile -t BROWSERS < <(find "$SHAREDIR/browsers" -type f -printf "%f\n")
else
  if ! declare -p BROWSERS | grep -q 'declare -a'; then
    # did not setup as array so redefine it here
    IFS=' ' read -r -a BROWSERS <<< "${BROWSERS[@]}"
  fi
fi

# remove duplicate elements if user accidentally polluted array with same entries
# https://stackoverflow.com/questions/13648410/how-can-i-get-unique-values-from-an-array-in-bash
readarray -t BROWSERS < <(printf '%s\n' "${BROWSERS[@]}" | awk '!x[$0]++')

# simple function to determine user intent rather than using a null value
case "${USE_SUSPSYNC,,}" in
  y|yes|true|t|on|1|enabled|enable|use)
    SUSPSYNC=1
    ;;
  *)
    SUSPSYNC=0
    ;;
esac

# since the default for this one is a yes, need to force a null value to yes
[[ -z "${USE_BACKUPS,,}" ]] && USE_BACKUPS="yes"

case "${USE_BACKUPS,,}" in
  y|yes|true|t|on|1|enabled|enable|use)
    CRRE=1
    ;;
  *)
    CRRE=0
    ;;
esac

header() {
  echo -e "${BLD}Profile-sync-daemon v$VERS${NRM}"
  echo
}

dep_check() {
  # checks for dependencies and that psd.conf is setup correctly
  if ! command -v rsync >/dev/null 2>&1; then
    die "I require rsync but it's not installed."
  fi
  if ! command -v modinfo >/dev/null 2>&1; then
    die "I require modinfo but it's not installed."
  fi
  for _bin in flock findmnt; do
    command -v "$_bin" >/dev/null 2>&1 || die "I require $_bin but it's not installed."
  done
  if ! command -v awk >/dev/null 2>&1; then
    die "I require awk but it's not installed."
  fi
  if ! command -v gdbus >/dev/null 2>&1; then
    if [[ $SUSPSYNC -eq 1 ]]; then
      die "I require gdbus but it's not installed."
    fi
  fi

  if [[ -f /etc/psd.conf ]]; then
    die "This version of psd does not support /etc/psd.conf since it runs as your user. Remove it and use systemd's user mode: systemctl --user <action> psd.service"
  fi
}

config_check() {
  # fuse3 is a depends of fuse-overlayfs but there are static builds floating around so to protect data, check for both
  for _bin in fuse-overlayfs fusermount3; do
    if ! command -v "$_bin" >/dev/null 2>&1; then
      die "To use overlayfs mode, install fuse-overlayfs and fuse3"
    fi
  done

  for browser in "${BROWSERS[@]}"; do
    if [[ ! -f "$SHAREDIR/browsers/$browser" ]]; then
      # user defined an invalid browser
      die "${RED}$browser${NRM}${BLD} is not a supported browser. Check config file for typos: ${NRM}${BLU}$PSDCONF"
    fi
  done
}

ungraceful_state_check() {
  # if the machine was ungracefully shutdown then the backup will be
  # on the filesystem and the link to tmpfs will be on the filesystem
  # but the contents will be empty we need to simply remove the link
  # and rotate the backup into place
  local browser legacy=0
  # sessions started by psd 7.04 or older never mark BACK_OVFS complete; their
  # config snapshot lacks PSD_SESSION_MARKERS and survives the crash
  if [[ -f "$PSDCONFDIR/.psd.conf" ]] &&
    ! grep -qx 'PSD_SESSION_MARKERS=1' "$PSDCONFDIR/.psd.conf"; then
    legacy=1
  fi
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    for item in "${DIRArr[@]}"; do
      profile_paths "$item"

      # all is well so continue
      [[ -e "$DIR/.flagged" ]] && continue

      NOW=$(date +%Y%m%d_%H%M%S)
      if [[ -h "$DIR" && "$(readlink "$DIR")" == "$TMP" ]]; then
        # psd's own link; while the mount is live it holds the newest data
        if mountpoint -q "$TMP"; then
          die "$TMP is still mounted but $DIR is not flagged; unsync it with: psd unsync"
        fi
        echo "Ungraceful state detected for $DIR so fixing"
        unlink "$DIR"
        findmnt -rn -M "$TMP" >/dev/null 2>&1 || rmdir "$TMP" 2>/dev/null
      elif [[ -h "$DIR" ]]; then
        # symlinked browser profiles are not supported so bail if one is detected
        if [[ -d $(readlink "$DIR") ]]; then
          die "${BLU}$DIR${NRM}${BLD} is a symlink, which psd does not support. Make the browser profile a real directory and try again."
        else
          echo "Ungraceful state detected for $DIR so fixing"
          unlink "$DIR"
        fi
      fi

      if [[ -d "$BACKUP" ]]; then
        if [[ -d $DIR ]]; then
          echo "Unexpected state detected: we have $BACKUP, but $DIR already exists. Trying move $DIR to $DIR" "$DIR-old-profile-$NOW"
          mv --no-target-directory "$DIR" "$DIR-old-profile-$NOW"
        fi

        if [[ -d "$BACK_OVFS" ]]; then
          # BACKUP (the lowerdir) is readonly so it holds the profile as it was
          # when psd started, while BACK_OVFS holds the last resync. BACK_OVFS is
          # only newer if a resync into it completed during this session, which
          # is marked by .psd-complete, otherwise it may be stale or partial

          if [[ -e "$BACK_OVFS/.psd-complete" ]]; then
            TARGETTOKEEP="$BACK_OVFS"
            TARGETTOSAVE="$BACKUP"
          elif [[ $legacy -eq 1 ]] &&
            [[ -n "$(find "$BACK_OVFS" -mindepth 1 -maxdepth 1 -print -quit)" ]] &&
            [[ $(stat -c %Z "$BACK_OVFS") -gt $(stat -c %Z "$BACKUP") ]]; then
            # an old session: use its rule, the newer copy unless it is empty
            echo "$DIR: crash in a session started by an older psd, using the newer copy; the other is kept as $BACKUP-crashrecovery-$NOW-unused"
            TARGETTOKEEP="$BACK_OVFS"
            TARGETTOSAVE="$BACKUP"
          else
            TARGETTOKEEP="$BACKUP"
            TARGETTOSAVE="$BACK_OVFS"
          fi

          if [[ $CRRE -eq 1 ]]; then
            cp -a --reflink=auto "$TARGETTOKEEP" "$BACKUP-crashrecovery-$NOW"
            rm -f "$BACKUP-crashrecovery-$NOW/.psd-complete"
          fi

          mv --no-target-directory "$TARGETTOKEEP" "$DIR"
          rm -f "$DIR/.psd-complete"

          # never delete the other copy, keep it unless it is empty
          rmdir "$TARGETTOSAVE" 2>/dev/null ||
            mv --no-target-directory "$TARGETTOSAVE" "$BACKUP-crashrecovery-$NOW-unused"
        else
          # we only find the BACKUP and no BACKOVFS then either the initial resync
          # never occurred before the crash using overlayfs or we aren't using overlayfs
          # at all which can be treated the same way

          if [[ $CRRE -eq 1 ]]; then
            cp -a --reflink=auto "$BACKUP" "$BACKUP-crashrecovery-$NOW"
          fi
          mv --no-target-directory "$BACKUP" "$DIR"
        fi
      fi
    done
  done
}

cleanup() {
  local browser
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    for item in "${DIRArr[@]}"; do
      DIR="$item"

      local CRASHArr=()
      crash_dirs "$DIR"

      if [[ ${#CRASHArr[@]} -gt 0 ]]; then
        echo -e "${BLD}Deleting ${#CRASHArr[@]} crashrecovery dir(s) for profile ${BLU}$DIR${NRM}"
        for backup in "${CRASHArr[@]}"; do
          echo -e "${BLD}${RED} $backup${NRM}"
          rm -rf "$backup"
        done
      else
        echo -e "${BLD}Found no crashrecovery dirs for: ${BLU}$DIR${NRM}${BLD}${NRM}"
      fi
      echo
    done
  done
}

# crash_dirs <dir> [snapshots]: set CRASHArr to the crashrecovery dirs of
# profile <dir>, newest first. With "snapshots" only the timestamped copies
# made by USE_BACKUPS are listed, not the -unused copies recovery sets aside.
crash_dirs() {
  local pattern path
  # escape glob characters in the profile name for find -name
  pattern=$(printf '%s' "${1##*/}" | sed 's/[][*?\\]/\\&/g')
  CRASHArr=()
  while IFS= read -d '' -r path; do
    if [[ "${2:-}" = snapshots ]] &&
      [[ ! "${path##*/}" =~ -backup-crashrecovery-[0-9]{8}_[0-9]{6}$ ]]; then
      continue
    fi
    CRASHArr+=("$path")
  done < <(find "${1%/*}" -maxdepth 1 -type d -name "$pattern-backup-crashrecovery-*" -print0 | sort -r -z)
}

# flush <path>: make everything written so far to the filesystem holding
# <path> durable, so a marker written after it cannot outlive the data
flush() {
  if ! sync -f "$1"; then
    error "Failed to flush $1 to disk"
    return 1
  fi
}

load_env_for() {
  browser="$1"

  homedir=$HOME
  group=$(id -g "$user")

  ### Arrays
  # profileArr is transient used to store profile paths parsed from
  # firefox and aurora
  unset profileArr
  # DIRArr is a full path corrected for both relative and absolute paths
  # reset global variables and arrays
  unset DIRArr

  unset PSNAME check_suffix
  . "$SHAREDIR/browsers/$browser"
}

running_check() {
  # check for browsers running and refuse to start if so
  # without this cannot guarantee profile integrity
  local browser
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    [[ -z "$PSNAME" ]] && continue
    if pgrep -x -u "$user" "$PSNAME" &>/dev/null; then
      echo "Refusing to start; $browser is running by $user!"
      exit 1
    fi
  done
}

# profile_paths <dir>: set the paths psd uses for profile <dir> of the
# browser last loaded with load_env_for. Multi-profile browsers (check_suffix)
# name the tmpfs dirs after the last directory of the profile path.
profile_paths() {
  local suffix=
  [[ -n "$check_suffix" ]] && suffix="-${1##*/}"
  DIR=$1
  BACKUP=$1-backup
  BACK_OVFS=$1-back-ovfs
  TMP=$VOLATILE/$user-$browser$suffix
  UPPER=$VOLATILE/$user-$browser$suffix-rw
  WORK=$VOLATILE/.$user-$browser$suffix
}

dup_check() {
  # every profile gets its own tmpfs, upper and work dir named after the
  # browser and, for multi-profile browsers, the LAST directory of the profile
  # path; two profiles sharing any of those names would be synced over each
  # other, so refuse to run if any name repeats across all browsers
  local browser item name
  local -A seen=() paths=()
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    for item in "${DIRArr[@]}"; do
      # only profiles psd will actually sync, each path once
      [[ -d "$item" || -h "$item" || -d "$item-backup" ]] || continue
      if [[ -n "${paths[$item]}" ]]; then
        # listed twice by one browser is harmless, by two is not
        [[ "${paths[$item]}" = "$browser" ]] && continue
        die "${BLU}$item${NRM}${BLD} is a profile of both ${paths[$item]} and $browser; remove one from BROWSERS."
      fi
      paths[$item]=$browser
      profile_paths "$item"
      for name in "${TMP##*/}" "${UPPER##*/}" "${WORK##*/}"; do
        if [[ -n "${seen[$name]}" ]]; then
          die "Profiles ${BLU}${seen[$name]}${NRM}${BLD} and ${BLU}$item${NRM}${BLD} would share ${BLU}$VOLATILE/$name${NRM}${BLD}. The last directory of each profile path must be unique, see the psd man page."
        fi
        seen[$name]=$item
      done
    done
  done
}

kill_browsers() {
  # check for browsers running and kill them to safely sync/unsync
  # without this cannot guarantee profile integrity
  local browser
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"

    local x=1
    while [[ $x -le 60 ]]; do
      [[ -n "$PSNAME" ]] || break
      pgrep -x -u "$user" "$PSNAME" &>/dev/null || break

      if [[ $x -le 5 ]]; then
        pkill -x -SIGTERM -u "$user" "$PSNAME"
      else
        pkill -x -SIGKILL -u "$user" "$PSNAME"
      fi

      x=$(( x + 1 ))
      sleep .05
    done
  done
}

# sync_profile <dir>: initial sync of one profile of the loaded browser. On
# failure nothing is left half done except what SYNCED_* records, which
# rollback_sync undoes.
sync_profile() {
  profile_paths "$1"

  if [[ -h "$DIR" ]]; then
    # recovery runs first, so a link here means another session owns it
    error "$DIR is already a link to $(readlink "$DIR"), not syncing it"
    return 1
  elif [[ ! -d "$DIR" ]]; then
    if [[ ! -d "$homedir" ]]; then
      error "$DIR does not exist! Is /home unmounted?"
      return 1
    elif [[ -d "$BACKUP" ]]; then
      error "$DIR does not exist but $BACKUP does, not syncing it"
      return 1
    fi
    # browser not installed
    return 0
  fi
  if mountpoint -q "$TMP"; then
    error "$TMP is still mounted from an earlier session, not syncing $DIR"
    return 1
  fi

  # writes left by an earlier session in this boot would be layered over the
  # profile on disk, which may be newer; keep them aside instead
  if unsaved_writes; then
    local stale
    stale="$XDG_RUNTIME_DIR/psd/.stale-${UPPER##*/}-$(date +%Y%m%d_%H%M%S)"
    mv --no-target-directory "$UPPER" "$stale" || return 1
    rm -rf "$WORK"
    warn "Writes left by an earlier session are kept in $stale, not used"
  fi

  # retain permissions on sync target
  PREFIXP=$(stat -c %a "$DIR")
  install -dm"$PREFIXP" --owner="$user" --group="$group" "$TMP" "$UPPER" "$WORK" || return 1

  # a BACK_OVFS left from a previous session is older than DIR, so its
  # marker must be gone before DIR becomes BACKUP
  if [[ -e "$BACK_OVFS/.psd-complete" ]]; then
    rm -f "$BACK_OVFS/.psd-complete"
    flush "$BACK_OVFS" || return 1
  fi
  mv --no-target-directory "$DIR" "$BACKUP" || return 1
  SYNCED_BROWSER+=("$browser")
  SYNCED_DIR+=("$1")

  overlay_opts="lowerdir=$BACKUP,upperdir=$UPPER,workdir=$WORK"
  if [[ $FIREJAIL -eq 1 ]]; then
    overlay_opts="allow_root,$overlay_opts"
  fi
  # the fuse daemon outlives psd, so it must not inherit the lock
  fuse-overlayfs -o "$overlay_opts" "$TMP" {lockfd}>&-
  if ! mountpoint -q "$TMP"; then
    error "Failed to mount $TMP"
    return 1
  fi

  ln -sT "$TMP" "$DIR" &&
    chown -h "$user":"$group" "$DIR" &&
    touch "$DIR/.flagged" || return 1
  msg "$browser sync successful"
}

# unsaved_writes: whether UPPER holds anything besides psd's own .flagged
unsaved_writes() {
  [[ -d "$UPPER" ]] &&
    [[ -n "$(find "$UPPER" -mindepth 1 ! -path "$UPPER/.flagged" -print -quit)" ]]
}

# rollback_sync: undo the profiles synced by a failed start, newest first
rollback_sync() {
  local i
  for (( i = ${#SYNCED_DIR[@]} - 1; i >= 0; i-- )); do
    load_env_for "${SYNCED_BROWSER[i]}"
    profile_paths "${SYNCED_DIR[i]}"
    [[ -h "$DIR" ]] && unlink "$DIR"
    if mountpoint -q "$TMP"; then
      fusermount3 -u "$TMP" || fusermount3 -uz "$TMP"
    fi
    if mountpoint -q "$TMP"; then
      error "Failed to unmount $TMP; $BACKUP is left for crash recovery"
      continue
    fi
    mv --no-target-directory "$BACKUP" "$DIR" || continue
    # anything written in the moments the overlay was up is kept, not deleted
    rm -f "$UPPER/.flagged"
    if rmdir "$UPPER" 2>/dev/null; then
      rm -rf "$WORK"
    else
      warn "Writes made during the failed start are kept in $UPPER"
    fi
    rmdir "$TMP" 2>/dev/null
    msg "${SYNCED_BROWSER[i]} sync undone"
  done
}

# resync_profile <dir>: copy one synced profile of the loaded browser to disk.
# Never moves, mounts or links anything: a profile that is not this session's
# link is left for the next start.
resync_profile() {
  profile_paths "$1"

  if [[ ! -h "$DIR" || "$(readlink "$DIR")" != "$TMP" ]]; then
    [[ -e "$DIR" || -h "$DIR" ]] &&
      warn "$DIR is not synced by this session; it is synced at the next start"
    return 0
  fi
  if [[ ! -e "$DIR/.flagged" ]]; then
    error "$TMP is not mounted, cannot resync $DIR"
    return 1
  fi

  # BACK_OVFS is created here rather than on the initial sync so a crash
  # before the first resync recovers from BACKUP
  if [[ ! -d "$BACK_OVFS" ]]; then
    install -dm"$(stat -c %a "$BACKUP")" --owner="$user" --group="$group" "$BACK_OVFS" || {
      error "Failed to create $BACK_OVFS"
      return 1
    }
  fi
  # .psd-complete tells ungraceful_state_check that BACK_OVFS is usable;
  # its removal must be on disk before rsync rewrites files in place,
  # and the data before it is put back
  rm -f "$BACK_OVFS/.psd-complete"
  flush "$BACK_OVFS" || return 1
  if ! rsync -aX --modify-window=-1 --delete-after --inplace --no-whole-file --exclude .flagged --exclude .psd-complete "$DIR/" "$BACK_OVFS/"; then
    error "Failed to resync $DIR to $BACK_OVFS"
    return 1
  fi
  flush "$BACK_OVFS" &&
    touch "$BACK_OVFS/.psd-complete" &&
    flush "$BACK_OVFS" || return 1
  msg "$browser resync successful"
}

# do_sync: the initial sync when no session is running, all or nothing, else a
# resync of every synced profile. Returns nonzero if anything failed.
do_sync() {
  local initial=0 browser item failed=0
  [[ -f "$PID_FILE" ]] || initial=1

  # make a snapshot of psd.conf and redefine its location to this snapshot
  # while psd is running to keep any edits made to the "live" psd.conf from
  # potentially orphaning the snapshot copies thus preserving the data; a
  # snapshot left by a crash is replaced when the next session starts

  if [[ $initial -eq 1 || ! -f "$PSDCONFDIR/.psd.conf" ]]; then
    rm -f "$PSDCONFDIR/.psd.conf.new"
    if ! {
      echo "# Automatically generated file; DO NOT EDIT!"
      echo "# The purpose is to snapshot the settings used when psd was activated."
      echo "# Any edits to the live config: $PSDCONFDIR/psd.conf"
      echo "# will be applied the _next_ time psd is activated."
      echo "#"
      echo "USE_SUSPSYNC=\"$USE_SUSPSYNC\""
      echo "BROWSERS=\"${BROWSERS[*]}\""
      echo "USE_BACKUPS=\"$USE_BACKUPS\""
      echo "BACKUP_LIMIT=\"$BACKUP_LIMIT\""
      echo "PSD_SESSION_MARKERS=1"
    } > "$PSDCONFDIR/.psd.conf.new"; then
      error "Failed to write $PSDCONFDIR/.psd.conf.new"
      return 2
    fi
    chmod 400 "$PSDCONFDIR/.psd.conf.new"
    # on disk before it replaces the old one; an empty snapshot would make
    # recovery treat this session as one started by an older psd
    if ! sync -f "$PSDCONFDIR/.psd.conf.new"; then
      error "Failed to flush $PSDCONFDIR/.psd.conf.new"
      return 2
    fi
    mv -f "$PSDCONFDIR/.psd.conf.new" "$PSDCONFDIR/.psd.conf"
  fi

  if [[ $initial -eq 1 ]]; then
    local -A seen_dirs=()
    SYNCED_BROWSER=()
    SYNCED_DIR=()
    for browser in "${BROWSERS[@]}"; do
      load_env_for "$browser"
      for item in "${DIRArr[@]}"; do
        # a def may list the same profile twice
        [[ -n "${seen_dirs[$item]}" ]] && continue
        seen_dirs[$item]=1
        if ! sync_profile "$item"; then
          error "Sync of $browser failed, undoing this start"
          rollback_sync
          return 2
        fi
      done
    done
    # the session exists only once every profile is synced
    touch "$PID_FILE"
  else
    for browser in "${BROWSERS[@]}"; do
      load_env_for "$browser"
      for item in "${DIRArr[@]}"; do
        resync_profile "$item" || failed=1
      done
    done
    [[ $failed -eq 0 ]] || return 2
  fi
}

enforce() {
  local browser
  for browser in "${BROWSERS[@]}"; do
  load_env_for "$browser"
  for DIR in "${DIRArr[@]}"; do
    local CRASHArr=()
    # only rotate timestamped snapshots, never the copies recovery set aside
    crash_dirs "$DIR" snapshots

    if [[ ${#CRASHArr[@]} -gt $BACKUP_LIMIT ]]; then
      for remove in "${CRASHArr[@]:$BACKUP_LIMIT}"; do
        rm -rf "$remove"
      done
    fi
  done
  done
}

do_unsync() {
  local browser failed=0
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    for item in "${DIRArr[@]}"; do
      profile_paths "$item"
      # check if user has browser profile
      if [[ -h "$DIR" ]]; then
        # the link and mount stay until the data is on disk, so a failure
        # below leaves the profile usable in tmpfs

        # unmount overlayfs FIRST while BACKUP still exists at original location
        # moving BACKUP before unmounting breaks the overlayfs mount (lowerdir path disappears)
        if mountpoint -q "$TMP"; then
          # sync latest changes from overlayfs to BACK_OVFS, then to BACKUP before unmounting
          # always update BACK_OVFS from live overlayfs first to capture latest changes
          if [[ -d "$BACK_OVFS" ]]; then
            # Update BACK_OVFS with latest changes from live overlayfs
            rm -f "$BACK_OVFS/.psd-complete"
            if ! flush "$BACK_OVFS" ||
              ! rsync -aX --modify-window=-1 --delete-after --inplace --no-whole-file --exclude .flagged --exclude .psd-complete "$TMP/" "$BACK_OVFS/" ||
              ! flush "$BACK_OVFS"; then
              error "Failed to sync $TMP to $BACK_OVFS during unsync, leaving $DIR in tmpfs"
              failed=1
              continue
            fi
            if ! touch "$BACK_OVFS/.psd-complete" || ! flush "$BACK_OVFS"; then
              error "Failed to mark $BACK_OVFS complete, leaving $DIR in tmpfs"
              failed=1
              continue
            fi
            # sync BACK_OVFS to BACKUP
            if ! rsync -aX --modify-window=-1 --delete-after --inplace --no-whole-file --exclude .flagged --exclude .psd-complete "$BACK_OVFS/" "$BACKUP/"; then
              error "Failed to sync $BACK_OVFS to $BACKUP during unsync, leaving $BACKUP for crash recovery"
              failed=1
              continue
            fi
          else
            # BACK_OVFS doesn't exist, sync directly from TMP to BACKUP
            if ! rsync -aX --modify-window=-1 --delete-after --inplace --no-whole-file --exclude .flagged "$TMP/" "$BACKUP/"; then
              error "Failed to sync $TMP to $BACKUP during unsync, leaving $DIR in tmpfs"
              failed=1
              continue
            fi
          fi
          # BACKUP was rewritten in place and becomes DIR below, where nothing
          # marks it as partial, so it must be on disk first
          if ! flush "$BACKUP"; then
            failed=1
            continue
          fi
          unlink "$DIR"
          # unmount (before moving BACKUP); everything is on disk by now, so
          # if something still holds the mount it is detached lazily and only
          # writes made after the copy above are lost
          if ! fusermount3 -u "$TMP"; then
            warn "$TMP is busy, detaching it lazily"
            fusermount3 -uz "$TMP"
          fi
          # never rm -rf through a live mount; leave this profile to crash
          # recovery and carry on with the others
          if mountpoint -q "$TMP"; then
            error "Failed to unmount $TMP, leaving it and $BACKUP in place"
            failed=1
            continue
          fi
          rm -rf "$TMP" "$UPPER" "$WORK"
        fi

        [[ -h "$DIR" ]] && unlink "$DIR"
        # restore BACKUP (which now has the changes merged in)
        if [[ -d "$BACKUP" ]] && ! mv --no-target-directory "$BACKUP" "$DIR"; then
          error "Failed to move $BACKUP back to $DIR, leaving it for crash recovery"
          failed=1
          continue
        fi
        [[ -d "$TMP" ]] && ! mountpoint -q "$TMP" && rm -rf "$TMP"
        msg "$browser unsync successful"
      else
        if [[ ! -d "$homedir" ]] ; then
          die "$DIR does not exist! Is /home unmounted?"
        fi
      fi
    done
  done
  # the session ends only when every profile is back on disk; otherwise the
  # PID and config snapshot are kept for recovery
  [[ $failed -eq 0 ]] || return 2
  rm -f "$PID_FILE" "$PSDCONFDIR/.psd.conf"
}

parse() {
  psd_state=$(systemctl --user is-active psd)
  resync_state=$(systemctl --user is-active psd-resync.timer)
  psd_suspend_sync_state=$(pgrep -cf "psd-suspend-sync")
  if [[ "$psd_suspend_sync_state" != 0 ]]; then
    psss_state="enabled"
  else
    psss_state="disabled"
  fi
  [[ "$psd_state" = "active" ]] && psd_color="${GRN}" || psd_color="${RED}"
  [[ "$resync_state" = "active" ]] && resync_color="${GRN}" || resync_color="${RED}"
  [[ "$psd_suspend_sync_state" != 0 ]] && psss_color="${GRN}" || psss_color="${RED}"
  echo -en " ${BLD}systemd service:"
  echo -e "$(tput cr)$(tput cuf 17) ${psd_color}$psd_state${NRM}${BLD}${NRM}"
  echo -en " ${BLD}resync-timer:"
  echo -e "$(tput cr)$(tput cuf 17) ${resync_color}$resync_state${NRM}${BLD}${NRM}"
  echo -en " ${BLD}sync on sleep:"
  echo -e "$(tput cr)$(tput cuf 17) ${psss_color}$psss_state${NRM}${BLD}${NRM}"
  echo
  echo -e "${BLD}Psd will manage the following per ${BLU}${PSDCONF}${NRM}${BLD}:${NRM}"
  echo
  local browser
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    for item in "${DIRArr[@]}"; do
      profile_paths "$item"
      # preview only reports; recovery is left to the next start
      if [[ ! -f $PID_FILE ]] && [[ -d "$BACKUP" || ( -h "$DIR" && ! -d "$DIR" ) ]]; then
        echo -e " ${BLD}browser/psname:$(tput cr)$(tput cuf 17) $browser/$PSNAME${NRM}"
        echo -e " ${BLD}sync target:$(tput cr)$(tput cuf 17) ${BLU}$DIR${NRM}"
        echo -e " ${RED}needs recovery:$(tput cr)$(tput cuf 17) ${NRM}${BLD}left by a crash; starting psd will recover it${NRM}"
        echo
        continue
      fi
      if [[ -d "$DIR" ]]; then
        local CRASHArr=()
        crash_dirs "$DIR"

        # get permissions on profile dir and be smart about it since symlinks are all 777
        [[ -f $PID_FILE ]] && TRUEP=$(stat -c %a "$BACKUP") || TRUEP=$(stat -c %a "$DIR")
        # since $XDG_RUNTIME_DIR is 700 by default so pass on by
        if [[ "$VOLATILE" = "$XDG_RUNTIME_DIR" ]]; then
          warn=
        else
          # using something other than $XDG_RUNTIME_DIR so check for privacy
          [[ $TRUEP -ne 700 ]] && warn=1
        fi
        # profile dir size
        psize=$(du -Dh --max-depth=0 "$DIR" 2>/dev/null | awk '{ print $1 }')
        echo -en " ${BLD}browser/psname:"
        echo -e "$(tput cr)$(tput cuf 17) $browser/$PSNAME${NRM}"
        echo -en " ${BLD}owner/group id:"
        echo -e "$(tput cr)$(tput cuf 17) $user/$group${NRM}"
        echo -en " ${BLD}sync target:"
        echo -e "$(tput cr)$(tput cuf 17) ${BLU}$DIR${NRM}"
        if [[ $warn -eq 1 ]]; then
          echo -e "$(tput cr)$(tput cuf 17) ${RED} Permissions are $TRUEP on this profile.${NRM}"
          echo -e "$(tput cr)$(tput cuf 17) ${RED} Recommend a setting of 700 for increased privacy!${NRM}"
          warn=
        fi
        echo -en " ${BLD}tmpfs dir:"
        echo -e "$(tput cr)$(tput cuf 17) ${GRN}$TMP${NRM}"
        echo -en " ${BLD}profile size:"
        echo -e "$(tput cr)$(tput cuf 17) $psize${NRM}"
        if [[ -f $PID_FILE ]]; then
          rwsize=$(du -Dh --max-depth=0 "$UPPER" 2>/dev/null | awk '{ print $1 }')
          echo -en " ${BLD}overlayfs size:"
          echo -e "$(tput cr)$(tput cuf 17) $rwsize${NRM}"
        fi
        if [[ $BACKUP_LIMIT -ne 5 ]]; then
          # only print if not the hardcoded default
          echo -en " ${BLD}backup limit:"
          echo -e "$(tput cr)$(tput cuf 17) $BACKUP_LIMIT${NRM}"
        fi
        echo -en " ${BLD}recovery dirs:"
        if [[ "${#CRASHArr[@]}" -eq 0 ]]; then
          echo -e "$(tput cr)$(tput cuf 17) none${NRM}"
        else
          echo -e "$(tput cr)$(tput cuf 17) ${RED}${#CRASHArr[@]}${NRM}${BLD} <- delete with the c option${NRM}"
          for backup in "${CRASHArr[@]}"; do
            psize=$(du -Dh --max-depth=0 "$backup" 2>/dev/null | awk '{ print $1 }')
            echo -en " ${BLD} dir path/size:"
            echo -e "$(tput cr)$(tput cuf 17) ${BLU}$backup ${NRM}${BLD}($psize)${NRM}"
          done
        fi
        echo
      fi
    done
  done
}

take_inhibit_lock() {
  # ensure we only take one lock at a time
  release_inhibit_lock

  # background this to avoid hanging on startup
  @BINDIR@/psd-suspend-sync {lockfd}>&- &
}

# take_lock wait|try: wait for other psd runs to finish, or with try exit
# quietly if one is running (a skipped resync is caught up by the next one)
take_lock() {
  if [[ $1 = try ]]; then
    flock -n "$lockfd"
    case $? in
      0) ;;
      1) msg "psd is busy, skipping"; exit 0 ;;
      *) die "Cannot take the lock $XDG_RUNTIME_DIR/psd.lock" ;;
    esac
  else
    # no timeout: going ahead without the lock would race a running sync,
    # and systemd's stop timeout already bounds a stuck holder
    flock "$lockfd" || die "Cannot take the lock $XDG_RUNTIME_DIR/psd.lock"
  fi
}

# recover: psd.service's ExecStopPost. It runs after every stop, also when
# the start failed or psd was killed, after systemd has killed the fuse
# daemons. A clean unsync left nothing to do.
recover() {
  local browser item
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    for item in "${DIRArr[@]}"; do
      profile_paths "$item"
      if [[ -f "$PID_FILE" ]] && [[ -e "$DIR/.flagged" ]] || mountpoint -q "$TMP"; then
        die "psd is running and $DIR is live; stop it with: systemctl --user stop psd"
      fi
    done
  done
  rm -f "$PID_FILE"
  # mounts whose fuse daemon is gone hide the profile; detach them
  for browser in "${BROWSERS[@]}"; do
    load_env_for "$browser"
    for item in "${DIRArr[@]}"; do
      profile_paths "$item"
      if findmnt -rn -M "$TMP" >/dev/null 2>&1; then
        fusermount3 -u "$TMP" 2>/dev/null || fusermount3 -uz "$TMP"
      fi
      if unsaved_writes; then
        warn "$UPPER holds writes made after the last copy to disk; they are not restored and are lost at reboot"
      fi
    done
  done
  ungraceful_state_check
}

release_inhibit_lock() {
  [[ "$(pgrep -cf "psd-suspend-sync")" != 0 ]] && pkill -f psd-suspend-sync
}

case "$1" in
  p|P|Parse|parse|Preview|preview|debug)
    dep_check
    config_check
    dup_check
    header
    parse
    ;;
  c|C|clean|Clean)
    take_lock wait
    dep_check
    config_check
    dup_check
    header
    cleanup
    ;;
  startup)
    # target for psd.service's ExecStart= for consistent error handling
    take_lock wait
    if [[ ! -f $PID_FILE ]]; then
      dep_check
      config_check
      dup_check
      running_check
      ungraceful_state_check
      [[ $SUSPSYNC -eq 1 ]] && take_inhibit_lock
      msg "psd startup check successful"
    fi
    ;;
  suspend-sync)
    # wait: a resync in progress has no complete copy until it finishes
    take_lock wait
    if [[ -f $PID_FILE ]]; then
      # system preparing for sleep mode, resync when psd is active
      do_sync || exit
    fi
    ;;
  recycle-inhibit-lock)
    # take inhibit lock for next suspend cycle
    take_inhibit_lock
    ;;
  sync|resync)
    if [[ -f $PID_FILE ]]; then
      take_lock try
      # an unsync may have ended the session while we waited for the check
      if [[ ! -f $PID_FILE ]]; then
        msg "psd is not running, skipping"
        exit 0
      fi
      do_sync || exit
    else
      take_lock wait
      dep_check
      config_check
      dup_check
      running_check
      ungraceful_state_check
      do_sync || exit
      enforce
    fi
    ;;
  unsync)
    take_lock wait
    if [[ -f $PID_FILE ]]; then
      # a failed resync here must not stop the unsync
      do_sync || warn "Resync before unsync failed, unsyncing anyway"
      kill_browsers
      do_unsync
      rc=$?
      [[ $SUSPSYNC -eq 1 ]] && release_inhibit_lock
      exit $rc
    fi
    ;;
  recover)
    take_lock wait
    recover
    [[ $SUSPSYNC -eq 1 ]] && release_inhibit_lock
    ;;
  *)
    header
    echo -e " ${BLD}$0 ${NRM}${GRN}[option]${NRM}"
    echo -e " ${BLD} ${NRM}${GRN}preview${NRM}${BLD}	Parse config file (${NRM}${BLU}${PSDCONF}${NRM}${BLD}) to see which profiles will be managed.${NRM}"
    echo -e " ${BLD} ${NRM}${GRN}clean${NRM}${BLD}		Clean (delete without prompting) ALL crashrecovery dirs for all profiles.${NRM}"
    echo
    echo -e " ${BLD}It is ${RED}HIGHLY DISCOURAGED${NRM}${BLD} to directly call $0 to sync, resync, or to unsync.${NRM}"
    echo
    if [[ -f /usr/lib/systemd/user/psd.service ]]; then
      echo -e " ${BLD}Instead, use systemd to start/stop profile-sync-daemon.${NRM}"
      echo
      echo -e " ${BLD}systemctl --user ${NRM}${GRN}[option]${NRM}${BLD} psd${NRM}"
      echo -e " ${BLD} ${NRM}${GRN}start${NRM}${BLD}		Turn on daemon; make symlinks and actively manage targets in tmpfs.${NRM}"
      echo -e " ${BLD} ${NRM}${GRN}stop${NRM}${BLD}		Turn off daemon; remove symlinks and rotate tmpfs data back to disc.${NRM}"
      echo -e " ${BLD} ${NRM}${GRN}enable${NRM}${BLD}	Autostart daemon when system comes up.${NRM}"
      echo -e " ${BLD} ${NRM}${GRN}disable${NRM}${BLD}	Remove daemon from the list of autostart daemons.${NRM}"
    elif [[ -f /etc/init.d/psd ]]; then
      echo -e " ${BLD}Instead, use the init system to start/stop profile-sync-daemon.${NRM}"
      echo
      echo -e " ${BLD}sudo service psd ${NRM}${GRN}[option]${NRM}${BLD} or /etc/init.d/psd ${NRM}${GRN}[option]${NRM}"
      echo -e " ${BLD} ${NRM}${GRN}start${NRM}${BLD}	Turn on daemon; make symlinks and actively manage targets in tmpfs.${NRM}"
      echo -e " ${BLD} ${NRM}${GRN}stop${NRM}${BLD}	Turn off daemon; remove symlinks and rotate tmpfs data back to disc.${NRM}"
    fi
    ;;
esac
exit 0

# vim:set ts=2 sw=2 et:
