# Zen Browser support for psd (modern + legacy paths)

if [[ -d "$XDG_CONFIG_HOME/zen" ]]; then
    ZEN_ROOT="$XDG_CONFIG_HOME/zen"
elif [[ -d "$HOME/.config/zen" ]]; then
    ZEN_ROOT="$HOME/.config/zen"
elif [[ -d "$HOME/.zen" ]]; then
    ZEN_ROOT="$HOME/.zen"
fi

if [[ -n "$ZEN_ROOT" ]]; then
    index=0
    PSNAME="$browser"

    while read -r profileItem; do
        if [[ "$profileItem" = /* ]]; then
            DIRArr[$index]="$profileItem"
        else
            DIRArr[$index]="$ZEN_ROOT/$profileItem"
        fi
        ((index++))
    done < <(grep '^[Pp]ath=' "$ZEN_ROOT/profiles.ini" | sed 's/^[Pp]ath=//')
fi

check_suffix=1
