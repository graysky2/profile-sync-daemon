#!/bin/bash
# Test shim, symlinked under each command name psd calls.
#
# PSD_TRACE=<file>      log every call ("name args") in order
# PSD_SHIM_COUNT=<file> counter of mutating calls
# PSD_FAULT=<n>:kill    SIGKILL psd's process group just before mutating call n
# PSD_FAULT=<n>:fail    make mutating call n exit 1 without running
# PSD_SHIM_VIOLATIONS   pkill on anything but a psdtst-* test process is
#                       refused and logged here; the runner fails the test
# PSD_REAL_FUSE         unset: fake fuse-overlayfs/fusermount3/mountpoint with
#                       plain directories, table in PSD_FAKE_MNT; mountpoints
#                       listed in PSD_FAKE_BUSY fail to unmount with EBUSY.
#                       Each fake mount runs a stand-in daemon that, like the
#                       real fuse daemon, inherits psd's open fds. Mounts
#                       whose daemon died are in PSD_FAKE_MNT.dead: findmnt
#                       lists them, mountpoint does not (ENOTCONN). Writes
#                       reach the upper dir only when the daemon dies (see
#                       kill_daemons), which marks it .fake-opaque: mounting
#                       it again shows it alone, deletions included.

name=${0##*/}
shimdir=$(cd -- "$(dirname -- "$0")" && pwd -P)

# drop every PATH entry that resolves to the shim dir, so nothing below can
# re-enter a shim
newpath=
IFS=: read -ra parts <<< "$PATH"
for p in "${parts[@]}"; do
  [[ "$(cd -- "$p" 2>/dev/null && pwd -P)" == "$shimdir" ]] && continue
  newpath+=${newpath:+:}$p
done
PATH=$newpath
real=$(command -v "$name")
if [[ -z "$real" || "$(cd -- "$(dirname -- "$real")" && pwd -P)" == "$shimdir" ]]; then
  echo "shim: cannot find real $name outside $shimdir" >&2
  exit 127
fi

[[ -n "$PSD_TRACE" ]] && printf '%s %s\n' "$name" "$*" >> "$PSD_TRACE"

if [[ "$name" == pkill ]]; then
  [[ "${*: -1}" == psdtst-* ]] || {
    echo "pkill $*" >> "$PSD_SHIM_VIOLATIONS"
    exit 1
  }
fi

if [[ "$name" != mountpoint && -n "$PSD_SHIM_COUNT" ]]; then
  n=$(( $(cat "$PSD_SHIM_COUNT" 2>/dev/null || echo 0) + 1 ))
  echo "$n" > "$PSD_SHIM_COUNT"
  if [[ "${PSD_FAULT%%:*}" == "$n" ]]; then
    [[ -n "$PSD_TRACE" ]] && echo "FAULT ${PSD_FAULT#*:} at $n" >> "$PSD_TRACE"
    case "${PSD_FAULT#*:}" in
      kill) kill -KILL -- -"$(ps -o pgid= $$ | tr -d ' ')" ;;
      fail) exit 1 ;;
    esac
  fi
fi

if [[ -z "$PSD_REAL_FUSE" ]]; then
  case "$name" in
    fuse-overlayfs)
      opts='' mnt=''
      while (( $# )); do
        case "$1" in
          -o) opts=$2; shift 2 ;;
          *) mnt=$1; shift ;;
        esac
      done
      lower=${opts#*lowerdir=}; lower=${lower%%,*}
      upper=${opts#*upperdir=}; upper=${upper%%,*}
      work=${opts#*workdir=}; work=${work%%,*}
      [[ -d "$lower" && -d "$upper" && -d "$work" && -d "$mnt" ]] ||
        { echo "fake fuse-overlayfs: bad args" >&2; exit 1; }
      if [[ -e "$upper/.fake-opaque" ]]; then
        (cd "$upper" && find . -mindepth 1 -maxdepth 1 ! -name .fake-opaque -exec cp -a {} "$mnt/" \;) || exit 1
      else
        cp -a "$lower/." "$mnt/" || exit 1
      fi
      rp=$(realpath "$mnt")
      echo "$rp" >> "$PSD_FAKE_MNT"
      echo "$rp $(realpath "$upper")" >> "$PSD_FAKE_MNT.upper"
      setsid sleep 86400 </dev/null >/dev/null 2>&1 &
      echo "$! $rp" >> "$PSD_FAKE_MNT.pids"
      exit 0
      ;;
    fusermount3)
      mnt=${*: -1}
      rp=$(realpath "$mnt" 2>/dev/null) || exit 1
      if grep -qxF "$rp" "$PSD_FAKE_MNT.dead" 2>/dev/null; then
        grep -vxF "$rp" "$PSD_FAKE_MNT.dead" > "$PSD_FAKE_MNT.new"
        mv -f "$PSD_FAKE_MNT.new" "$PSD_FAKE_MNT.dead"
        exit 0
      fi
      grep -qxF "$rp" "$PSD_FAKE_MNT" || { echo "fusermount3: $mnt not mounted" >&2; exit 1; }
      lazy=
      for a in "$@"; do [[ "$a" == -*z* ]] && lazy=1; done
      if grep -qxF "$rp" "$PSD_FAKE_BUSY" && [[ -z "$lazy" ]]; then
        echo "fusermount3: failed to unmount $mnt: Device or resource busy" >&2
        exit 1
      fi
      grep -vxF "$rp" "$PSD_FAKE_MNT" > "$PSD_FAKE_MNT.new"
      mv -f "$PSD_FAKE_MNT.new" "$PSD_FAKE_MNT"
      while read -r pid path; do
        [[ "$path" == "$rp" ]] && kill "$pid" 2>/dev/null
      done < "$PSD_FAKE_MNT.pids"
      find "$rp" -mindepth 1 -delete
      exit 0
      ;;
    sync)
      # durability is checked by the order in PSD_TRACE; a real syncfs here
      # would only flush the host disk over and over. Like syncfs it needs
      # the path to exist.
      [[ -e "${*: -1}" ]] || { echo "sync: error opening '${*: -1}'" >&2; exit 1; }
      exit 0
      ;;
    mountpoint)
      rp=$(realpath "${*: -1}" 2>/dev/null) && grep -qxF "$rp" "$PSD_FAKE_MNT" && exit 0
      ;;
    findmnt)
      # the -M <path> lookup and the listing psd uses
      for (( i = 1; i < $#; i++ )); do
        if [[ "${!i}" == -M ]]; then
          j=$(( i + 1 ))
          rp=$(realpath "${!j}" 2>/dev/null) || exit 1
          cat "$PSD_FAKE_MNT" "$PSD_FAKE_MNT.dead" 2>/dev/null | grep -xF "$rp"
          exit
        fi
      done
      # escaped like findmnt -r does
      cat "$PSD_FAKE_MNT" "$PSD_FAKE_MNT.dead" 2>/dev/null | grep -v '^$' |
        sed 's/\\/\\x5c/g; s/ /\\x20/g'
      exit 0
      ;;
  esac
fi

exec "$real" "$@"
